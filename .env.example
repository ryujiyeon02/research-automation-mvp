# 로컬에서만 사용하는 비밀값입니다. 실제 키를 Git에 커밋하지 마세요.
RESEARCH_DB_PATH=data/research.db

# SEC는 API 키가 없지만 식별 가능한 User-Agent가 필요합니다.
SEC_USER_AGENT="Your Name your-email@example.com"

# 로컬 LLM: API 키 없이 Ollama에서 실행합니다.
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 국내 데이터 소스(후속 연결용)
DART_API_KEY=
KRX_AUTH_KEY=
KIS_APP_KEY=
KIS_APP_SECRET=
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# 메리츠증권 Open API (실계좌 키 — 이 프로젝트는 조회 API만 호출합니다)
# 포털에 등록한 IP에서만 호출됩니다.
MERITZ_APP_KEY=
MERITZ_APP_SECRET=

# 거시 시계열(후속 연결용)
ECOS_API_KEY=
FRED_API_KEY=
